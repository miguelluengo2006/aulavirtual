# Base de datos PostgreSQL (Neon, Supabase o local)
# Local: postgres://usuario:contraseña@localhost:5432/aulavirtual
# Supabase: Project Settings → Database → Connection string (Transaction pooler, puerto 6543)
DATABASE_URL=

# Better Auth: genera un secreto con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (vídeos). Dashboard → R2 → Manage API tokens → token con
# "Object Read & Write" solo para el bucket de vídeos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Próximas fases
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
