# Base de datos PostgreSQL (Neon, Supabase o local)
# Local: postgres://usuario:contraseña@localhost:5432/aulavirtual
# Supabase: Project Settings → Database → Connection string (Transaction pooler, puerto 6543)
DATABASE_URL=

# Better Auth: genera un secreto con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Emails (confirmar cuenta, recuperar contraseña). Con Resend: https://resend.com
# Sin RESEND_API_KEY no se envían emails y no se exige confirmar el email.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend
EMAIL_FROM="IDESIE AV <hola@tu-dominio.com>"
# Solo en local: escribe los emails en la consola en vez de enviarlos
# EMAIL_DEV_CONSOLE=1

# Cloudflare R2 (vídeos). Dashboard → R2 → Manage API tokens → token con
# "Object Read & Write" solo para el bucket de vídeos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Próximas fases
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
